# ══════════════════════════════════════════════════════════════
#   CONFIGURATION & STOCKAGE CENTRALISÉ DES TOKENS (SNU UNILU)
# ══════════════════════════════════════════════════════════════

# 1. Clé API Google Gemini (Claudia IA RAG)
# Obtenez votre clé sur : https://aistudio.google.com/
GEMINI_API_KEY=

# 2. Token de Sécurité Administration (CMS)
# Ce jeton protège les écritures API (/api/content et /api/upload)
ADMIN_API_TOKEN=snu_admin_token_secure_2026

# 3. Clé secrète de session (JWT / Session)
JWT_SECRET=snu_jwt_secret_unilu_token_987654321

# 4. Port d'écoute du Backend Flask (par défaut: 5050)
PORT=5050

# 5. Configuration de l'environnement (development / production)
FLASK_ENV=production
DEBUG=False
