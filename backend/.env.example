# ══════════════════════════════════════════════════════════════════════
#  SALLE DU NUMÉRIQUE UNILU (SNU) — TEMPLATE DE CONFIGURATION SÉCURISÉE
# ══════════════════════════════════════════════════════════════════════
# Ce fichier sert d'exemple (.env.example).
# Copiez-le vers "backend/.env" (qui est ignoré par Git pour des raisons de sécurité)
# et remplissez vos vraies valeurs.
#
#   $ cp backend/.env.example backend/.env
#
# 100% Python — Aucun runtime Java nécessaire.
# ══════════════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────────────
# 1. CLÉS D'AUTHENTIFICATION & SÉCURITÉ DE L'ADMINISTRATION
# ──────────────────────────────────────────────────────────────────────
# Jeton API secret pour autoriser les modifications CMS et uploads via API.
# Transmis dans le header "Authorization: Bearer <ADMIN_API_TOKEN>"
# ou "X-Admin-Token: <ADMIN_API_TOKEN>"
ADMIN_API_TOKEN=votre_jeton_admin_secret_super_securise_2026

# Mot de passe administrateur par défaut pour l'interface /admin
ADMIN_DEFAULT_PASSWORD=snu@2026!

# Clé secrète de signature des sessions et jetons JWT
JWT_SECRET=votre_cle_secrete_jwt_longue_et_aleatoire_987654321

# ──────────────────────────────────────────────────────────────────────
# 2. INTELLIGENCE ARTIFICIELLE CLAUDIA (RAG & GEMINI)
# ──────────────────────────────────────────────────────────────────────
# Clé API Google Gemini pour faire fonctionner l'assistant vocal et textuel Claudia
# Obtenez une clé gratuite ou pro sur : https://aistudio.google.com/
GEMINI_API_KEY=AIzaSy...votre_cle_api_google_gemini_ici

# Modèle Gemini à utiliser (recommandé: gemini-1.5-flash ou gemini-2.0-flash)
GEMINI_MODEL=gemini-1.5-flash

# ──────────────────────────────────────────────────────────────────────
# 3. RÉSEAU, PORTS & RESTRICTIONS CORS
# ──────────────────────────────────────────────────────────────────────
# Hôte d'écoute (0.0.0.0 pour écouter sur toutes les interfaces, ou 127.0.0.1 en local strict)
HOST=0.0.0.0

# Port du serveur unifié (Site + Admin + CMS + Messagerie) : par défaut 8080
# Port du microservice Claudia Flask : par défaut 5050
PORT=8080
CLAUDIA_PORT=5050

# Origines autorisées pour les requêtes CORS (sécurité inter-domaines)
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,https://snu-unilu.cd

# ──────────────────────────────────────────────────────────────────────
# 4. LIMITES DE SÉCURITÉ DES FICHIERS & SESSIONS
# ──────────────────────────────────────────────────────────────────────
# Taille maximale des fichiers autorisés en upload (en octets, ex: 10 Mo = 10485760)
MAX_CONTENT_LENGTH=10485760

# Durée de validité d'une session administrateur (en secondes, ex: 86400 = 24h)
SESSION_LIFETIME_SECONDS=86400

# ──────────────────────────────────────────────────────────────────────
# 5. MODE D'EXÉCUTION (ENVIRONNEMENT)
# ──────────────────────────────────────────────────────────────────────
# Mode : 'production' pour bloquer les détails d'erreurs, 'development' pour déboguer
FLASK_ENV=production
DEBUG=False
